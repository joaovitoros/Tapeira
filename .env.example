# Copy to ".env" and adjust if needed. Compose loads this file automatically.

# Host port that maps to the game. Container always listens on 8080.
TAPEIRA_PORT=8080

# Image tag built by `docker compose build`.
TAPEIRA_TAG=latest

# Pin the nginx base image (override to update it in one place).
NGINX_IMAGE=nginxinc/nginx-unprivileged:1.27-alpine
